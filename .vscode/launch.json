{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PadPilot (app)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/PadPilot.App/bin/Debug/net10.0/PadPilot.dll",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "PadPilot Probe (consola)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tools/PadPilot.Probe/bin/Debug/net10.0/PadPilot.Probe.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
