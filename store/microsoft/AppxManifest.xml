<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto MSIX de PadPilot para la Microsoft Store.
  Los valores __ENTRE_GUIONES__ los rellena build-msix.ps1 con los datos de tu cuenta de Partner Center
  (Product management → Product identity).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="__IDENTITY_NAME__" Publisher="__PUBLISHER__" Version="__VERSION__" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PadPilot</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <Application Id="PadPilot" Executable="PadPilot\PadPilot.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PadPilot"
        Description="Controller manager for DualSense, DualShock 4 and generic controllers."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="PadPilot" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- App de escritorio Win32: habla con los mandos por HID y con los drivers ViGEmBus/HidHide -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Prueba del micrófono del mando (pestaña Audio) -->
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
